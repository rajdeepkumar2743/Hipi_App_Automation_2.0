# =========================================================
# FILE: .env.example
# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real credentials.
# =========================================================

# Required — used by testdata/test_data.py for the valid
# login smoke/regression tests. Fails fast at collection
# time (see conftest.py pytest_configure) if missing.
TEST_PHONE=9876543210
TEST_OTP=5186

# Optional — override any config/config.py default without
# touching code. Uncomment and set as needed.

# APPIUM_SERVER=http://127.0.0.1:4723
# PLATFORM_NAME=Android
# TEST_ENV=qa

# App reset strategy — set to true if app is preinstalled
NO_RESET=true

# Optional — per-environment APK/IPA paths (see
# config/environments.py). Only needed if your build
# artifacts live somewhere other than resources/apps/.

# QA_APK_PATH=resources/apps/hipi_qa.apk
# STAGING_APK_PATH=resources/apps/hipi_staging.apk
# PROD_APK_PATH=resources/apps/hipi_prod.apk

# QA_IOS_BUNDLE_ID=com.zee5.hipi.qa
# QA_IPA_PATH=resources/apps/hipi_qa.app
