# Copy this file to .env and replace the placeholder values.
# Keep .env local and do not commit it.

# Required for login tests
TEST_PHONE=your_phone_number
TEST_OTP=your_otp

# Optional: used only if you run cloud device farms such as BrowserStack
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# Optional: app/environment overrides
QA_APK_PATH=
STAGING_APK_PATH=
PROD_APK_PATH=
QA_IOS_BUNDLE_ID=
STAGING_IOS_BUNDLE_ID=
PROD_IOS_BUNDLE_ID=
QA_IPA_PATH=
STAGING_IPA_PATH=
PROD_IPA_PATH=
TEST_ENV=qa
